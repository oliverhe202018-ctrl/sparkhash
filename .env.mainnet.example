# ==============================================================================
# PoolCoin BSC 主网 (Chain ID: 56) 部署环境变量模板
# 使用方式: 复制为 .env (仅在部署机本地保存，严禁提交至公共仓库)
# ==============================================================================

# BSC 主网 RPC 配置 (chainId 56)
RPC_URL=https://bsc-dataseed.binance.org/

# 部署者 EOA 私钥 (严格仅由 Deploy.s.sol 读取变量 PRIVATE_KEY，部署完成后部署者 Admin 角色全部原子销毁或转移至 Timelock)
PRIVATE_KEY=0x...

# Etherscan / BscScan API Key (用于合约开源验证，支持 chainid=56)
ETHERSCAN_API_KEY=your_bscscan_api_key_here

# ------------------------------------------------------------------------------
# 治理与多签实体 (均已在 BSC 主网上链并严格校验)
# ------------------------------------------------------------------------------
# 1. Timelock Proposer Safe (2/3 门限多签，负责时间锁排期与提案)
# 签名人: 0xe46B423cB80E3f4D4c7d77086dC275a2082B08d6, 0xB51c1Aceb413F7FaCF2cF961E6828A5E5585577A, 0xBae2A1209Be311000Bd5Ef1feEaa08b6A8432060
TIMELOCK_PROPOSER_SAFE=0x93C38CCB01e223752FF25c066bAE732c38d2d89d

# 2. Guardian Safe (1/2 门限应急多签，负责系统单向熔断暂停，与 Proposer 零重叠)
# 签名人: 0x439071B227ff27500617b7eb5C92a48ed675e605, 0x7F0f3D785e330b194c0e70dC6167F196afc4AddE
# 备用同签名人 Safe: 0x8fB757B9fe9223dAC2CDFbC3404b1B944a7a4B42
GUARDIAN_SAFE=0x4bfB20aA015707832a5f7000fa272d3547eaD6E3

# 3. 时间锁公示时延 (主网必须为 172800 秒 / 48 小时；双重校验防止手误)
TIMELOCK_MIN_DELAY=172800
DISCLOSURE_TIMELOCK_DELAY=172800

# ------------------------------------------------------------------------------
# 代币初始预分配接收地址 (均已在 BSC 主网上链/确认)
# ------------------------------------------------------------------------------
# 4. 流动性金库 Safe (2/3 门限多签，接收 50% / 5000 万代币)
LIQUIDITY_WALLET=0xc2bD3Ff8197c41622E38c32A9aeeC2051ec4b625

# 5. 社区金库 Safe (2/3 门限多签，接收 20% / 2000 万代币)
COMMUNITY_MULTISIG=0xD3aE35e5eD47B87c7EfEb90a17174C5BaCa6032E

# 6. 团队 Vesting 受益人 (接收 VestingWallet 线性释放的 30% / 3000 万代币)
TEAM_BENEFICIARY=0x439071B227ff27500617b7eb5C92a48ed675e605
TEAM_VESTING_WALLET=0x439071B227ff27500617b7eb5C92a48ed675e605

# ------------------------------------------------------------------------------
# 关键系统启动参数
# ------------------------------------------------------------------------------
# START_TIMESTAMP: 必须晚于当前时间至少 1 小时的整点 Unix 时间戳 (3600 的整倍数)
# 动态整点计算 (PowerShell):
#   $now = [DateTimeOffset]::UtcNow.AddHours(2); [DateTimeOffset]::new($now.Year, $now.Month, $now.Day, $now.Hour, 0, 0, [TimeSpan]::Zero).ToUnixTimeSeconds()
# 若不指定，部署脚本将默认自动计算为当前时间 2 小时后的整点
# START_TIMESTAMP=

# 质押与限额参数
DEPOSIT_BNB=10000000000000000
MIN_DEPOSIT=1000000000000000
MAX_DEPOSIT=10000000000000000000
MIN_DEPOSIT_INTERVAL_EPOCHS=24
MAX_DEPOSIT_MULTIPLIER=2

# ------------------------------------------------------------------------------
# 主网 Keeper 自动化运维机器人配置 (部署完成后启用)
# ------------------------------------------------------------------------------
MINER_ADDRESS=0x...
KEEPER_PRIVATE_KEY=0x...
